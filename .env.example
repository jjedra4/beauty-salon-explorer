# ──────────────────────────────────────────────────────────────────────────
# Warsaw Beauty Salon Explorer — environment configuration
#
# Copy to `.env` (`cp .env.example .env`). The app runs fully on committed
# seed data with NO keys set — keys are only needed to (re)run the data
# pipeline or to enable live AI semantic search.
# ──────────────────────────────────────────────────────────────────────────

# --- Database (defaults match docker-compose) ---
POSTGRES_USER=salon
POSTGRES_PASSWORD=salon
POSTGRES_DB=salon
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS (frontend dev + docker)
CORS_ORIGINS=http://localhost:3000

# --- AI providers (OPTIONAL) ---
# Without OPENAI_API_KEY the app still runs: semantic search degrades to a
# keyword/trigram fallback, and the pipeline cannot regenerate enrichment.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Needed ONLY to (re)collect raw data in the pipeline (Google Places API New).
GOOGLE_MAPS_API_KEY=

# --- Frontend ---
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
